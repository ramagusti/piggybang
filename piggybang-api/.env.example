APP_NAME="PiggyBang!"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# CORS_ORIGIN_PATTERN="#^https://([a-z0-9-]+\.)?piggybang\.app$#"
# TRUSTED_PROXIES=*

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local: sqlite. Supabase: use the Session pooler (IPv4), port 5432 — not the transaction pooler (6543).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_SCHEMA=piggybang   # own schema when sharing a Supabase project
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file   # rate limiter hits this on every request: never "database" with a remote DB; use redis when running >1 server
QUEUE_CONNECTION=database
# Upstash Redis (spec): REDIS_URL=rediss://default:<pw>@<host>:6379 then CACHE_STORE=redis QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local
RECEIPTS_DISK=public
# Supabase Storage (S3-compatible): composer require league/flysystem-aws-s3-v3, RECEIPTS_DISK=s3, AWS_* below
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Email (Resend works via SMTP: smtp.resend.com:465, user "resend", password = API key)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@piggybang.app"
MAIL_FROM_NAME="PiggyBang!"

# WhatsApp bridge → /api/entries/ingest HMAC secret
INGEST_SECRET=

# AI (9Router or any OpenAI-compatible gateway)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o

# Meta WhatsApp Cloud API (platform app; system-user token does not expire)
META_GRAPH_VERSION=v21.0
META_SYSTEM_USER_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WABA_ID=
META_PLATFORM_PHONE=
META_PLATFORM_PHONE_NUMBER_ID=

# Payments
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Xendit codes, comma-separated; each must be activated in the Xendit dashboard
XENDIT_PAYMENT_METHODS=QRIS,OVO,DANA,SHOPEEPAY,LINKAJA

# Supabase Realtime (Project Settings → API). JWT secret signs per-org realtime tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# DANGER: true = nightly permanent delete of Free-plan transactions older than 2 years
FREE_RETENTION_ENABLED=false

# Web Push notifications (run `php artisan push:keys` once, paste the output here)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
